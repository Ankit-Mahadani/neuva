# Neuva Language Grammar

start: statement*

statement: print_stmt NEWLINE
         | let_stmt NEWLINE
         | model_def
         | train_stmt
         | save_stmt NEWLINE
         | predict_stmt
         | func_def
         | return_stmt NEWLINE
         | if_stmt
         | for_stmt
         | while_stmt
         | match_stmt
         | import_stmt NEWLINE
         | assign_stmt NEWLINE
         | expr_stmt NEWLINE
         | NEWLINE

// Print statement
print_stmt: _PRINT expr ("," expr)*

// Variable declaration
let_stmt: _LET NAME ("," NAME)* (":" type)? "=" expr

// Import statement — loads a stdlib module into the current environment
import_stmt: _IMPORT NAME

// Model definition
model_def: _MODEL NAME "{" NEWLINE layer_stmt* "}"  NEWLINE

layer_stmt: _LAYER NAME "(" NUMBER ARROW NUMBER "," NAME   ")" NEWLINE  -> layer_dense
          | _LAYER NAME "(" NUMBER ARROW NUMBER "," NUMBER ")" NEWLINE  -> layer_conv
          | _LAYER NAME "(" NUMBER ARROW NUMBER ")"            NEWLINE  -> layer_seq
          | _LAYER NAME "(" NUMBER ")"                         NEWLINE  -> layer_pool
          | _LAYER NAME "(" NUMBER "," NUMBER ")"              NEWLINE  -> layer_pair
          | _LAYER NAME "(" NUMBER "," NUMBER "," NUMBER ")"   NEWLINE  -> layer_triple
          | _LAYER NAME                                        NEWLINE  -> layer_no_args
          | _OUTPUT NAME ":" NAME "(" NUMBER ARROW NUMBER "," NAME ")" NEWLINE -> output_dense

// Train statement
train_stmt: _TRAIN NAME _ON NAME _FOR NUMBER _EPOCHS ("," train_opt)* NEWLINE
          | _TRAIN NAME NEWLINE train_body

train_body: _ON NAME NEWLINE _FOR NUMBER _EPOCHS NEWLINE (train_opt NEWLINE)*

// lr/early_stop/lr_warmup take a full expr so they can be parametrized by a variable
// (e.g. a hyperparameter-search loop variable), not just a literal number.
train_opt: _LR "=" expr                 -> opt_lr
         | _LOSS "=" NAME               -> opt_loss
         | _LR_SCHEDULE "=" NAME        -> opt_lr_schedule
         | _EARLY_STOP "=" expr         -> opt_early_stop
         | _LR_WARMUP "=" expr          -> opt_lr_warmup

// Save statement
save_stmt: _SAVE NAME _TO expr

// Predict statement
predict_stmt: _PREDICT NAME _ON NAME NEWLINE

// Function definition
func_def: _FN NAME "(" param_list? ")" ("->" type)? "{" NEWLINE statement* "}" NEWLINE

param_list: param ("," param)*

param: NAME (":" type)?

// Return statement
return_stmt: _RETURN expr?

// If / else if / else statement
if_stmt: _IF expr "{" NEWLINE statement* "}" elif_clause* else_clause? NEWLINE
elif_clause: _ELSE _IF expr "{" NEWLINE statement* "}"
else_clause: _ELSE "{" NEWLINE statement* "}"

// For loop
for_stmt: _FOR NAME _IN expr for_body NEWLINE
for_body: "{" NEWLINE statement* "}"

// While loop
while_stmt: _WHILE expr while_body NEWLINE
while_body: "{" NEWLINE statement* "}"

// Match / case statement
match_stmt: _MATCH expr "{" NEWLINE case_clause* default_clause? "}" NEWLINE
case_clause: _CASE literal ":" statement
default_clause: _DEFAULT ":" statement

// Assignment statement (reassignment of an existing variable)
assign_stmt: NAME "=" expr        -> assign
           | NAME AUGOP expr      -> aug_assign

// Expression statement (standalone call or assignment)
expr_stmt: expr

// Expressions — or_expr > and_expr > comparison > sum > product > unary > call_or_attr
?expr: or_expr

?or_expr: and_expr
        | or_expr _OR and_expr -> or_

?and_expr: comparison
         | and_expr _AND comparison -> and_

?comparison: sum
           | sum "==" sum -> eq
           | sum "!=" sum -> ne
           | sum "<"  sum -> lt
           | sum "<=" sum -> le
           | sum ">"  sum -> gt
           | sum ">=" sum -> ge

?sum: product
    | sum "+" product -> add
    | sum "-" product -> sub

?product: unary
        | product "*" unary -> mul
        | product "/" unary -> div
        | product "%" unary -> mod

?unary: "-" unary -> neg
      | "!" unary -> not_
      | _NOT unary -> not_
      | call_or_attr

?call_or_attr: call_or_attr "." NAME "(" arg_list? ")" -> method_call
             | call_or_attr "(" arg_list? ")" -> func_call
             | call_or_attr "[" expr "]" -> index_expr
             | primary

?primary: "(" expr ")"
        | dict_lit
        | list_lit
        | literal
        | NAME -> var

// List literal
list_lit: "[" "]"
        | "[" expr ("," expr)* "]"

// Dict literal
dict_lit: "{" "}"
        | "{" dict_entry ("," dict_entry)* "}"
dict_entry: expr ":" expr

arg_list: expr ("," expr)*

// Literals
literal: INT           -> int_lit
       | FLOAT         -> float_lit
       | TRIPLE_STRING -> triple_string_lit
       | STRING        -> string_lit
       | BOOL          -> bool_lit

// Types
type: _KW_INT    -> type_int
    | _KW_FLOAT  -> type_float
    | _KW_BOOL   -> type_bool
    | _KW_STRING -> type_string
    | _KW_TENSOR -> type_tensor
    | _KW_MATRIX -> type_matrix

// Terminals
// Keywords are anchored with a negative lookahead so they don't swallow the prefix of a
// longer identifier (e.g. "print_loss_curve" must lex as one NAME, not PRINT + "_loss_curve").
// The leading underscore keeps them filtered out of the parse tree, matching plain string
// literals' default behavior.
_KW_BOUNDARY: /(?![A-Za-z0-9_])/
_PRINT: "print" _KW_BOUNDARY
_LET: "let" _KW_BOUNDARY
_IMPORT: "import" _KW_BOUNDARY
_MODEL: "model" _KW_BOUNDARY
_LAYER: "layer" _KW_BOUNDARY
_OUTPUT: "output" _KW_BOUNDARY
_TRAIN: "train" _KW_BOUNDARY
_ON: "on" _KW_BOUNDARY
_FOR: "for" _KW_BOUNDARY
_IN: "in" _KW_BOUNDARY
_EPOCHS: "epochs" _KW_BOUNDARY
_LR_SCHEDULE: "lr_schedule" _KW_BOUNDARY
_EARLY_STOP: "early_stop" _KW_BOUNDARY
_LR: "lr" _KW_BOUNDARY
_LOSS: "loss" _KW_BOUNDARY
_SAVE: "save" _KW_BOUNDARY
_TO: "to" _KW_BOUNDARY
_PREDICT: "predict" _KW_BOUNDARY
_FN: "fn" _KW_BOUNDARY
_RETURN: "return" _KW_BOUNDARY
_IF: "if" _KW_BOUNDARY
_ELSE: "else" _KW_BOUNDARY
_WHILE: "while" _KW_BOUNDARY
_MATCH: "match" _KW_BOUNDARY
_CASE: "case" _KW_BOUNDARY
_DEFAULT: "default" _KW_BOUNDARY
_AND: "and" _KW_BOUNDARY
_OR: "or" _KW_BOUNDARY
_NOT: "not" _KW_BOUNDARY
_LR_WARMUP: "lr_warmup" _KW_BOUNDARY
_KW_INT: "int" _KW_BOUNDARY
_KW_FLOAT: "float" _KW_BOUNDARY
_KW_BOOL: "bool" _KW_BOUNDARY
_KW_STRING: "string" _KW_BOUNDARY
_KW_TENSOR: "tensor" _KW_BOUNDARY
_KW_MATRIX: "matrix" _KW_BOUNDARY

BOOL: "true" | "false"
TRIPLE_STRING.2: /"""[\s\S]*?"""/
STRING: "\"" /[^"\\]*/ "\""
INT: /[0-9]+/
FLOAT: /[0-9]+\.[0-9]*/
NUMBER: /[0-9]+(\.[0-9]*)?/
NAME: /[a-zA-Z_][a-zA-Z0-9_]*/
NEWLINE: /\n/
ARROW: "->"
AUGOP: "+=" | "-=" | "*=" | "/="

%ignore /\#[^\n]*/
%ignore /[ \t\r]+/
