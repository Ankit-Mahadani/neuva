# Custom loss function demo
# Define a loss function in Neuva itself and use it in `train`.

model Regressor {
    layer dense(8 -> 32, relu)
    layer dense(32 -> 1, linear)
}

fn my_loss(pred, target) {
    return mse(pred, target) + 0.1
}

let data = load("examples/data/housing.csv")
let data = data.normalize()
let train_data, test_data = data.split(0.8)

train Regressor on train_data for 10 epochs, lr = 0.001, loss = my_loss
predict Regressor on test_data
