# Digit Classifier — MNIST
let data = load("mnist.csv")
let train_data, test_data = data.split(0.8)

model DigitNet {
    layer dense(784 -> 128, relu)
    layer dense(128 -> 64,  relu)
    layer dense(64  -> 10,  softmax)
}

train DigitNet
    on train_data
    for 20 epochs
    lr   = 0.001
    loss = crossentropy

let acc = accuracy(DigitNet, test_data)
print "Test accuracy:", acc
save DigitNet to "digit_model.nva"
