# Linear Regression in Neuva
let data = load("housing.csv")
let train_data, test_data = data.split(0.8)

model HousePredictor {
    layer dense(10 -> 64, relu)
    layer dense(64 -> 1,  linear)
}

train HousePredictor on train_data for 50 epochs, lr=0.01, loss=mse
predict HousePredictor on test_data
