# Regression — predicting house prices
# Expects housing.csv with 8 feature columns and a continuous price label

let data = load("examples/data/housing.csv")
let data = data.normalize()
let train_data, test_data = data.split(0.8)

model HousePredictor {
    layer dense(8 -> 64, relu)
    layer dense(64 -> 32, relu)
    layer dense(32 -> 1, linear)
}

train HousePredictor on train_data for 50 epochs, lr = 0.001, loss = mse
predict HousePredictor on test_data
